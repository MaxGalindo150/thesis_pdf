\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces Evolución de las componentes de pérdida durante el fine-tuning completo. Obsérvese cómo la pérdida física inicialmente alta se reduce progresivamente mientras la red aprende a incorporar el conocimiento físico sin comprometer la calidad de reconstrucción directa.}}{36}{}\protected@file@percent }
\newlabel{fig:finetuning_dynamics}{{5.2}{36}{}{figure.5.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.3}{\ignorespaces Diagrama de radar mostrando la evolución de las métricas de evaluación a lo largo del proceso de fine-tuning. Cada eje representa una métrica, y el área total cubierta por el polígono indica la mejora global en la calidad de reconstrucción.}}{37}{}\protected@file@percent }
\newlabel{fig:radar_plot}{{5.3}{37}{}{figure.5.3}{}}
