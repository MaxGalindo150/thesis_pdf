\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces Evolución de las componentes de pérdida durante el fine-tuning completo. Obsérvese cómo la pérdida física inicialmente alta se reduce progresivamente mientras la red aprende a incorporar el conocimiento físico sin comprometer la calidad de reconstrucción directa.\relax }}{23}{}\protected@file@percent }
