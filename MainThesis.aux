\newlabel{sub@fig:reconstructed_signals}{{b}{24}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.3}{\ignorespaces Análisis del impacto de la supervisión física en el proceso de fine-tuning. (a) Evolución de las pérdidas al eliminar la componente física, mostrando un comportamiento significativamente diferente. (b) Comparación directa de las señales fotoacústicas reconstruidas por los diferentes modelos, evidenciando la mejora en la consistencia física.\relax }}{24}{}\protected@file@percent }
\newlabel{fig:physical_supervision_impact}{{5.3}{24}}
