\newlabel{fig:intensity_profile}{{5.10}{47}{}{figure.5.10}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {5.5.4}Visualización de Características Aprendidas}{47}{}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {5.11}{\ignorespaces Mapas de activación de características intermedias en las redes duales. La fila superior muestra las activaciones en diferentes etapas de la red reconstructora, mientras que la fila inferior muestra las activaciones en la red supervisora. Se observa la evolución de las representaciones desde patrones generales hasta estructuras específicas.}}{48}{}\protected@file@percent }
\newlabel{fig:feature_maps}{{5.11}{48}{}{figure.5.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.12}{\ignorespaces Mapas de atención en diferentes capas del decodificador de la red reconstructora. Las áreas en colores cálidos representan regiones con mayor influencia en la salida del modelo. En capas profundas (dec3) el modelo atiende a características globales, mientras que en capas superficiales (dec1) se enfoca en detalles locales y bordes.}}{49}{}\protected@file@percent }
\newlabel{fig:attention_maps}{{5.12}{49}{}{figure.5.12}{}}
